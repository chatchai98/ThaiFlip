#include "version.h"

1 ICON "assets/tabthai.ico"

1 VERSIONINFO
FILEVERSION APP_VERSION_COMMA
PRODUCTVERSION APP_VERSION_COMMA
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Chatchai Jomta"
            VALUE "FileDescription", "TabThai - Thai/English keyboard layout correction"
            VALUE "FileVersion", APP_VERSION_STRING
            VALUE "InternalName", "tabthai"
            VALUE "LegalCopyright", "Copyright (c) 2026 Chatchai Jomta"
            VALUE "OriginalFilename", "TabThai.exe"
            VALUE "ProductName", "TabThai"
            VALUE "ProductVersion", APP_VERSION_STRING
            VALUE "Comments", "MIT License. Contact: chatchai.j98@gmail.com"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
